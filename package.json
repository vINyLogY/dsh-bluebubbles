{
  "name": "dsh-bluebubbles",
  "version": "0.1.0",
  "description": "BlueBubbles (iMessage) bridge plugin for DeepSeek Harness: REST tools + webhook push routed into bound workspaces.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./heartbeat": "./src/heartbeat.ts",
    "./cron": "./src/cron.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:runtime": "node --test test/runtime/integration.mjs",
    "test:chat-compat": "node --test compat/chat-completions/test/*.test.mjs",
    "test:chat-compat-profile": "node compat/chat-completions/test/profile-integration.mjs",
    "test:workflow-compat-pure": "node --check compat/legacy-workflow/src/index.mjs && node --check compat/legacy-workflow/src/engine.mjs && node --check compat/legacy-workflow/src/transport.mjs && node --check compat/legacy-workflow/src/protocol.mjs && node --check compat/legacy-workflow/src/worker.cjs && node --test compat/legacy-workflow/test/protocol.test.mjs compat/legacy-workflow/test/transport.test.mjs",
    "test:integration": "node test/integration.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.1 || 0.1.1-rc.2 || 0.1.7-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/dsh": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.1.1-rc.2",
    "@types/node": "^26.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=23.6"
  },
  "bin": {
    "bb-channel": "bin/bb-channel.mjs"
  },
  "files": [
    "src",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
