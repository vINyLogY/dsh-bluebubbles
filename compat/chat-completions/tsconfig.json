{
  "compilerOptions": {
    "target": "es2023", "module": "nodenext", "moduleResolution": "nodenext",
    "lib": ["es2023", "dom"], "types": ["node"], "strict": true,
    "noEmit": true, "skipLibCheck": true, "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.mts"]
}
